@model Restaurant.Application.DTOs.MonAnDto

@{
    ViewData["Title"] = Model.TenMon;
}

<a asp-action="Index" class="back-link">&larr; Quay lại thực đơn</a>
<div class="row g-5 align-items-center mt-2 food-detail">
    <div class="col-md-6">
        @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
        {
            <div class="food-detail-image"><img src="@Model.HinhAnh" alt="@Model.TenMon" /></div>
        }
        else
        {
            <div class="food-detail-image food-image-placeholder">
                <span>Bếp Việt</span>
            </div>
        }
    </div>
    <div class="col-md-6">
        <p class="eyebrow mb-2"><span></span> @Model.TenDanhMuc</p>
        <h1 class="display-5 mb-3">@Model.TenMon</h1>
        <p class="food-detail-description">@Model.MoTa</p>
        <p class="food-detail-price">@Model.DonGia.ToString("N0") <small>đ</small></p>
        <form asp-controller="Cart" asp-action="Add" method="post" class="food-detail-order d-flex flex-wrap gap-2">
            <input type="hidden" name="foodId" value="@Model.MaMon" />
            <input type="number" name="quantity" value="1" min="1" max="99" class="form-control" style="max-width: 100px;" aria-label="Số lượng" />
            <button type="submit" class="btn btn-gold px-4">Thêm vào giỏ hàng</button>
        </form>
    </div>
</div>
