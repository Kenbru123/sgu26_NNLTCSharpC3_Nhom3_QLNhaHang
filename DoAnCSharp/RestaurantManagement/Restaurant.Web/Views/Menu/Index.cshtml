@model Restaurant.Web.Models.MenuViewModel

@{
    ViewData["Title"] = "Thực đơn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Thực đơn</h1>
        <p class="text-secondary mb-0">Chọn món yêu thích và đặt hàng trực tuyến.</p>
    </div>
    <a class="btn btn-outline-success" asp-controller="Cart" asp-action="Index">Xem giỏ hàng</a>
</div>

@if (TempData["CartError"] is string error)
{
    <div class="alert alert-warning">@error</div>
}
@if (TempData["CartMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm tên món hoặc mô tả..." />
    </div>
    <div class="col-md-4">
        <select name="categoryId" class="form-select">
            <option value="">Tất cả danh mục</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.MaDanhMuc" selected="@(Model.CategoryId == category.MaDanhMuc)">
                    @category.TenDanhMuc
                </option>
            }
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button class="btn btn-success" type="submit">Tìm món</button>
    </div>
</form>

@if (Model.Foods.Count == 0)
{
    <div class="alert alert-info">Không tìm thấy món ăn phù hợp.</div>
}
else
{
    <div class="row g-4">
        @foreach (var food in Model.Foods)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(food.HinhAnh))
                    {
                        <img src="@food.HinhAnh" class="card-img-top" alt="@food.TenMon" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="text-secondary small">@food.TenDanhMuc</div>
                        <h5 class="card-title mt-1">@food.TenMon</h5>
                        <p class="card-text text-secondary flex-grow-1">@food.MoTa</p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <strong class="text-success">@food.DonGia.ToString("N0") đ</strong>
                            <a asp-action="Details" asp-route-id="@food.MaMon">Chi tiết</a>
                        </div>
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="foodId" value="@food.MaMon" />
                            <button type="submit" class="btn btn-success w-100">Thêm vào giỏ</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
