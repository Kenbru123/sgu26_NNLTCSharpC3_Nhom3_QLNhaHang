@model IReadOnlyList<Restaurant.Application.DTOs.MonAnDto>

@{
    ViewData["Title"] = "Trang chủ";
}

<section class="home-hero mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7 home-hero-copy">
            <p class="eyebrow"><span></span> MÓN NGON MỖI NGÀY</p>
            <h1>Trọn vị món ngon,<br /><span>ấm lòng bữa Việt.</span></h1>
            <p class="home-hero-description">Từ nguyên liệu tươi ngon đến từng món ăn chỉn chu, chúng tôi mang hương vị thân quen đến ngay bàn ăn của bạn.</p>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <a class="btn btn-gold btn-lg px-4" asp-controller="Menu" asp-action="Index">Đặt món ngay</a>
                <a class="btn btn-outline-gold btn-lg px-4" asp-controller="Menu" asp-action="Index">Khám phá thực đơn</a>
            </div>
            <div class="hero-footnote"><span class="hero-footnote-mark">✦</span> Nấu tươi mỗi ngày · Phục vụ tận tâm</div>
        </div>
        <div class="col-lg-5">
            <div class="home-hero-visual" aria-label="Một số món ăn nổi bật">
                <div class="hero-glow"></div>
                <div class="hero-food hero-food-main"><img src="~/images/foods/ga-ran.jpg" alt="Gà rán vàng giòn" /></div>
                <div class="hero-food hero-food-top"><img src="~/images/foods/lau-thai.jpg" alt="Lẩu Thái nóng hổi" /></div>
                <div class="hero-food hero-food-bottom"><img src="~/images/foods/com-ga-xoi-mo.jpg" alt="Cơm gà xối mỡ" /></div>
                <div class="hero-food hero-food-side"><img src="~/images/foods/bo-luc-lac.jpg" alt="Bò lúc lắc" /></div>
                <div class="hero-visual-caption"><span>HƯƠNG VỊ NHÀ LÀM</span><strong>Ngon từ điều giản dị</strong></div>
            </div>
        </div>
    </div>
</section>

<section class="featured-section">
    <div class="section-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <p class="eyebrow mb-2"><span></span> ĐƯỢC YÊU THÍCH</p>
            <h2 class="mb-0">Món ngon nổi bật</h2>
        </div>
        <a class="section-link" asp-controller="Menu" asp-action="Index">Xem toàn bộ thực đơn <span aria-hidden="true">→</span></a>
    </div>
    <div class="row g-4">
    @foreach (var food in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <article class="card food-card h-100">
                @if (!string.IsNullOrWhiteSpace(food.HinhAnh))
                {
                    <a class="food-card-image" asp-controller="Menu" asp-action="Details" asp-route-id="@food.MaMon">
                        <img src="@food.HinhAnh" alt="@food.TenMon" loading="lazy" />
                        <span class="food-image-arrow" aria-hidden="true">↗</span>
                    </a>
                }
                else
                {
                    <div class="food-card-image food-image-placeholder"><span>Bếp Việt</span></div>
                }
                <div class="card-body d-flex flex-column">
                    <span class="food-category">@food.TenDanhMuc</span>
                    <h3 class="food-card-title">@food.TenMon</h3>
                    <p class="food-card-description flex-grow-1">@food.MoTa</p>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <strong class="food-price">@food.DonGia.ToString("N0") đ</strong>
                        <a class="btn btn-outline-gold btn-sm px-3" asp-controller="Menu" asp-action="Details" asp-route-id="@food.MaMon">Chi tiết</a>
                    </div>
                </div>
            </article>
        </div>
    }
    </div>
</section>
