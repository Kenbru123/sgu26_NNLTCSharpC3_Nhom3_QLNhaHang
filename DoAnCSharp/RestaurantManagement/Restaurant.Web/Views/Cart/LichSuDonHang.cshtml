@model IReadOnlyList<Restaurant.Application.DTOs.OnlineOrderResponse>
@{
	ViewData["Title"] = "Đơn đã đặt";
}

<div class="page-heading mb-4">
	<p class="eyebrow mb-2"><span></span> LỊCH SỬ CỦA BẠN</p>
	<h1 class="display-5 mb-2">Đơn đã đặt</h1>
</div>

@if (Model.Count == 0)
{
	<div class="alert alert-info">Bạn chưa có đơn hàng online nào.</div>
}
else
{
	foreach (var order in Model)
	{
		<section class="card mb-4 shadow-sm">
			<div class="card-header d-flex justify-content-between align-items-center">
				<strong>Đơn #@order.MaDonHang</strong>
				<span class="badge bg-success">@order.TrangThaiDon</span>
			</div>
			<div class="card-body">
				<div class="row mb-3">
					<div class="col-md-4"><strong>Thời gian:</strong> @order.ThoiGianTao.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</div>
					<div class="col-md-4"><strong>Hình thức:</strong> @(order.LoaiDon == "OnlineGiaoHang" ? "Giao hàng" : "Nhận tại quầy")</div>
					<div class="col-md-4"><strong>Giao hàng:</strong> @(order.TrangThaiGiao ?? "Không áp dụng")</div>
				</div>
				<p><strong>Người nhận:</strong> @order.TenNguoiNhan - @order.SDTNguoiNhan</p>
				@if (!string.IsNullOrWhiteSpace(order.DiaChiGiao))
				{
					<p><strong>Địa chỉ:</strong> @order.DiaChiGiao</p>
				}
				<table class="table table-sm">
					<thead>
						<tr><th>Món</th><th class="text-center">Số lượng</th><th class="text-end">Thành tiền</th></tr>
					</thead>
					<tbody>
					@foreach (var item in order.MonAn)
					{
						<tr>
							<td>@item.TenMon</td>
							<td class="text-center">@item.SoLuong</td>
							<td class="text-end">@item.ThanhTien.ToString("N0") đ</td>
						</tr>
					}
					</tbody>
				</table>
				<div class="text-end fw-bold">Tổng tiền: @order.TongTien.ToString("N0") đ</div>
			</div>
		</section>
	}
}
