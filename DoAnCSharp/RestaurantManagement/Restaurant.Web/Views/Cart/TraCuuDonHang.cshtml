@model Restaurant.Application.DTOs.GuestOrderLookupRequest
@{
	ViewData["Title"] = "Tra cứu đơn hàng";
}

<h1 class="mb-4">Tra cứu đơn hàng</h1>
<p class="text-secondary">Nhập số điện thoại người nhận để xem các đơn hàng của bạn.</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-controller="Cart" asp-action="Lookup" method="post" class="row g-3 col-md-6">
	@Html.AntiForgeryToken()
	<div class="col-12">
		<label asp-for="SDTNguoiNhan" class="form-label">Số điện thoại người nhận</label>
		<input asp-for="SDTNguoiNhan" class="form-control" autocomplete="tel" />
		<span asp-validation-for="SDTNguoiNhan" class="text-danger"></span>
	</div>
	<div class="col-12">
		<button type="submit" class="btn btn-success">Tra cứu</button>
	</div>
</form>
