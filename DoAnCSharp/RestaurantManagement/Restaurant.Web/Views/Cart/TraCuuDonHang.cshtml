@model Restaurant.Application.DTOs.GuestOrderLookupRequest
@{
	ViewData["Title"] = "Tra cứu đơn hàng";
}

<div class="page-heading mb-4">
	<p class="eyebrow mb-2"><span></span> THEO DÕI ĐƠN HÀNG</p>
	<h1 class="display-5 mb-2">Tra cứu đơn hàng</h1>
</div>
<p class="text-secondary">Nhập số điện thoại người nhận để xem các đơn hàng của bạn.</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-controller="Cart" asp-action="Lookup" method="post" class="lookup-card row g-3 col-md-7">
	@Html.AntiForgeryToken()
	<div class="col-12">
		<label asp-for="SDTNguoiNhan" class="form-label">Số điện thoại người nhận</label>
		<input asp-for="SDTNguoiNhan" class="form-control" autocomplete="tel" />
		<span asp-validation-for="SDTNguoiNhan" class="text-danger"></span>
	</div>
	<div class="col-12">
		<button type="submit" class="btn btn-gold px-4">Tra cứu</button>
	</div>
</form>
