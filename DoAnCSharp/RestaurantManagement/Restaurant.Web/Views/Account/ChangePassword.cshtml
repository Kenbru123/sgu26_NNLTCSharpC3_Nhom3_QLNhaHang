@model Restaurant.Web.Models.ChangePasswordViewModel
@{
	ViewData["Title"] = "Đổi mật khẩu";
}

<div class="account-page account-password-page">
	<div class="mb-4">
		<p class="text-uppercase small fw-semibold text-success mb-2">Bảo mật</p>
		<h1 class="display-6 fw-bold">Đổi mật khẩu</h1>
		<p class="text-muted mb-0">Nhập mật khẩu hiện tại để tạo mật khẩu mới.</p>
	</div>

	<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
	<div class="card shadow-sm border-0 account-card">
		<div class="card-body p-4">
			<form asp-action="ChangePassword" method="post">
				<div class="mb-3">
					<label asp-for="MatKhauHienTai" class="form-label"></label>
					<input asp-for="MatKhauHienTai" class="form-control" autocomplete="current-password" />
					<span asp-validation-for="MatKhauHienTai" class="text-danger"></span>
				</div>
				<div class="mb-3">
					<label asp-for="MatKhauMoi" class="form-label"></label>
					<input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password" />
					<span asp-validation-for="MatKhauMoi" class="text-danger"></span>
				</div>
				<div class="mb-4">
					<label asp-for="NhapLaiMatKhauMoi" class="form-label"></label>
					<input asp-for="NhapLaiMatKhauMoi" class="form-control" autocomplete="new-password" />
					<span asp-validation-for="NhapLaiMatKhauMoi" class="text-danger"></span>
				</div>
				<div class="d-flex gap-2">
					<button type="submit" class="btn btn-success">Đổi mật khẩu</button>
					<a asp-action="Profile" class="btn btn-outline-secondary">Quay lại tài khoản</a>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
